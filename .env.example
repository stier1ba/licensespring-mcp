# ---- License API (choose ONE authentication method) ----
LICENSE_API_URL=https://api.licensespring.com

# Option A: API key + shared key (HMAC request signing). BOTH are required.
# Portal: Settings → Keys
LICENSE_API_KEY=your_license_api_key_here
LICENSE_SHARED_KEY=your_license_shared_key_here

# Option B: OAuth client credentials (takes precedence when set)
# LICENSE_CLIENT_ID=auth-company-xxxxxxxx
# LICENSE_CLIENT_SECRET=your_client_secret
# LICENSE_OAUTH_TOKEN_URL=https://auth.licensespring.com/realms/user-portal/protocol/openid-connect/token

# ---- Management API ----
# Portal: Settings → Keys → Management API key (different from the License API keys)
MANAGEMENT_API_URL=https://saas.licensespring.com
MANAGEMENT_API_KEY=your_management_api_key_here

# ---- Logging (always written to stderr) ----
# LOG_LEVEL=warn   # error | warn | info | debug

# ---- Live integration tests (npm run test:integration) ----
# LS_TEST_PRODUCT=your_product_short_code
# LS_INTEGRATION_WRITE=1   # also run create/update/delete round-trips
