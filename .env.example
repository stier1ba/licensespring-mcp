# --- License API server ----------------------------------------------------
# Option 1: API key authorization. Both values are required; every request is
# HMAC-signed with the shared key. Find them under Settings > Keys.
LICENSE_API_KEY=your_license_api_key_here
LICENSE_SHARED_KEY=your_license_shared_key_here

# Option 2: OAuth client credentials (takes precedence when set).
# LICENSE_CLIENT_ID=auth-company-123456
# LICENSE_CLIENT_SECRET=your_client_secret_here
# LICENSE_OAUTH_TOKEN_URL=https://auth.licensespring.com/realms/user-portal/protocol/openid-connect/token

LICENSE_API_URL=https://api.licensespring.com

# --- Management API server -------------------------------------------------
MANAGEMENT_API_KEY=your_management_api_key_here
MANAGEMENT_API_URL=https://saas.licensespring.com

# --- Optional ----------------------------------------------------------------
# LICENSESPRING_TIMEOUT_MS=25000
# LICENSESPRING_MAX_RETRIES=2
# LOG_LEVEL=INFO
# Register only some Management toolsets (default: all 173 tools)
# MANAGEMENT_TOOLSETS=licenses,license_users,orders,customers,products,devices,analytics,consumption_pools,oauth_clients
# Register only read-only tools on both servers
# LICENSESPRING_READ_ONLY=false
